{
  "name": "@geastack/starter-counter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal JSX counter with one tiny store.",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@geajs/core": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "counter",
    "name": "Counter",
    "description": "Minimal JSX counter with one tiny store.",
    "entry": "index.tsx",
    "runtime": "gea",
    "targets": {
      "web": true,
      "esp32": true,
      "geaos": true,
      "macos": false,
      "ios": false
    }
  }
}

{
  "name": "@geastack/cli",
  "version": "0.1.62",
  "type": "module",
  "description": "Command-line front door for GeaStack apps, targets, and local toolchains.",
  "publishConfig": {
    "access": "restricted"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "bin/",
    "src/",
    "starters/",
    "examples/",
    "docs/",
    "README.md"
  ],
  "exports": {
    ".": "./src/gea.mjs",
    "./create": "./src/create-geastack.mjs",
    "./errors": "./src/errors.mjs"
  },
  "bin": {
    "gea": "bin/gea.mjs",
    "create-geastack": "bin/create-geastack.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "picocolors": "^1.1.1",
    "serialport": "^13.0.0"
  },
  "starterDependencies": {
    "@geastack/core": "^0.1.12",
    "@geastack/targets": "^0.1.60"
  },
  "scripts": {
    "check": "node --check bin/gea.mjs && node --check bin/create-geastack.mjs && find src test packages -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "SEE LICENSE IN LICENSE"
}
